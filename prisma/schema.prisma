generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl      = env("DATABASE_URL")
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
  INSANE
}

enum Category {
  WEB
  PWN
  CRYPTO
  FORENSICS
  MISC
  REV
  OSINT
}

enum Status {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum Role {
  USER
  ADMIN
}

model User {
  id           String    @id @default(uuid()) @db.VarChar(36)
  username     String    @unique @db.VarChar(50)
  email        String    @unique @db.VarChar(100)
  passwordHash String    @db.VarChar(255)
  role         Role      @default(USER)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  writeups     Writeup[]

  @@map("users")
}

model Writeup {
  id          String     @id @default(uuid()) @db.VarChar(36)
  userId      String     @db.VarChar(36)
  title       String     @db.VarChar(200)
  ctfName     String     @db.VarChar(100)
  category    Category
  difficulty  Difficulty
  flag        String?    @db.VarChar(255)
  description String?    @db.Text
  status      Status     @default(DRAFT)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  steps       Step[]

  @@index([userId])
  @@index([status])
  @@map("writeups")
}

model Step {
  id            String   @id @default(uuid()) @db.VarChar(36)
  writeupId     String   @db.VarChar(36)
  orderIndex    Int
  description   String   @db.Text
  command       String?  @db.Text
  commandOutput String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  writeup       Writeup  @relation(fields: [writeupId], references: [id], onDelete: Cascade)
  images        Image[]

  @@index([writeupId])
  @@map("steps")
}

model Image {
  id                  String   @id @default(uuid()) @db.VarChar(36)
  stepId              String   @db.VarChar(36)
  cloudinaryPublicId  String   @unique @db.VarChar(255)
  secureUrl           String   @db.VarChar(500)
  originalFilenameHash String  @db.VarChar(64)
  fileSizeBytes       Int
  uploadedAt          DateTime @default(now())
  step                Step     @relation(fields: [stepId], references: [id], onDelete: Cascade)

  @@index([stepId])
  @@map("images")
}